{
    "name": "blackcube/dboard-bridge",
    "description": "Blackcube Dboard bridge for non-Yii3 frameworks",
    "keywords": [
        "cms",
        "admin",
        "blackcube",
        "dboard",
        "bridge"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/blackcubeio/dboard-bridge",
    "authors": [
        {
            "name": "Philippe Gaultier",
            "email": "philippe@blackcube.io"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "blackcube/dboard": "@dev",
        "blackcube/yii-assets": "^1.0",
        "httpsoft/http-message": "^1.1",
        "yiisoft/config": "^1.6",
        "yiisoft/csrf": "^2.2",
        "yiisoft/data-response": "^2.2",
        "yiisoft/log": "^2.2",
        "yiisoft/log-target-file": "^3.1",
        "yiisoft/rbac-db": "^2.1",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/session": "^3.0",
        "yiisoft/yii-runner-http": "^3.2",
        "yiisoft/yii-view-renderer": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Blackcube\\DboardBridge\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-devel": "1.x-dev"
        },
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    }
}
